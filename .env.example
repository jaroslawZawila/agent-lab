# Copy to .env and fill in. Only the keys for the providers you use are needed.

# --- Model providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Models use "provider:model" strings (LangChain initChatModel format).
# Strong model for reasoning, cheap model for graders/classifiers (and routing in P11).
MODEL_STRONG=anthropic:claude-sonnet-5-5
MODEL_CHEAP=anthropic:claude-haiku-5-5

# Embeddings: openai:<model> | google-genai:<model> | fake:synthetic (offline, for tests)
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Tracing (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-lab

# --- Infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgres://agent:agent@localhost:5432/agentlab
REDIS_URL=redis://localhost:6379
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentlab-dev

# Relative to the repo root.
CORPUS_DIR=corpus
