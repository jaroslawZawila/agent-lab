{
  "name": "agent-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "graph:up": "docker compose --profile graph up -d neo4j",
    "ingest": "pnpm --filter @agent-lab/core ingest",
    "smoke": "pnpm --filter @agent-lab/core smoke"
  }
}
